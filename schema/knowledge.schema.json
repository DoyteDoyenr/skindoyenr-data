{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/DoyteDoyenr/skindoyenr-data/main/schema/knowledge.schema.json",
  "title": "SkinDoyenr knowledge base",
  "description": "What the build advisor knows about champions, items and runes. Champion profiles describe threats; items and runes say which threats they answer. The app downloads this file and re-downloads it whenever dataVersion changes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "dataVersion", "patch", "generatedAt", "threats", "champions", "items", "runes"],
  "properties": {
    "schemaVersion": { "const": 1, "description": "Shape of this file. The app refuses versions it does not know." },
    "dataVersion": { "type": "integer", "minimum": 1, "description": "Increases on every publish; the app updates when it sees a higher one." },
    "patch": { "type": "string", "pattern": "^\\d+\\.\\d+(\\.\\d+)?$", "description": "Game patch the data was written for, e.g. 16.20.1." },
    "generatedAt": { "type": "string", "format": "date-time" },
    "threats": {
      "type": "object",
      "description": "Human-readable label for every threat id, pt-BR.",
      "propertyNames": { "$ref": "#/$defs/threat" },
      "additionalProperties": { "type": "string" }
    },
    "champions": {
      "type": "object",
      "description": "Keyed by champion id (Data Dragon key, e.g. \"103\" for Ahri).",
      "propertyNames": { "pattern": "^\\d+$" },
      "additionalProperties": { "$ref": "#/$defs/champion" }
    },
    "items": {
      "type": "object",
      "description": "Keyed by item id. Only items the advisor may recommend.",
      "propertyNames": { "pattern": "^\\d+$" },
      "additionalProperties": { "$ref": "#/$defs/item" }
    },
    "runes": {
      "type": "object",
      "description": "Keyed by perk id.",
      "propertyNames": { "pattern": "^\\d+$" },
      "additionalProperties": { "$ref": "#/$defs/rune" }
    }
  },
  "$defs": {
    "level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3,
      "description": "0 none, 1 low, 2 medium, 3 high."
    },
    "threat": {
      "description": "What an enemy brings that a build can answer.",
      "enum": [
        "physicalDamage",
        "magicDamage",
        "trueDamage",
        "burst",
        "poke",
        "sustainedDamage",
        "healing",
        "shielding",
        "crowdControl",
        "mobility",
        "tankiness",
        "percentHealthDamage",
        "attackSpeed",
        "critical",
        "invisibility",
        "execute",
        "range"
      ]
    },
    "archetype": {
      "description": "What kind of champion a recommendation suits.",
      "enum": ["mage", "assassinAP", "assassinAD", "marksman", "fighter", "juggernaut", "diver", "tank", "enchanter", "catcher", "specialist"]
    },
    "position": { "enum": ["TOP", "JUNGLE", "MID", "BOTTOM", "SUPPORT"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ability", "summary"],
      "properties": {
        "ability": { "enum": ["P", "Q", "W", "E", "R"] },
        "summary": { "type": "string", "description": "pt-BR, short: what it does and its numbers/scaling, from the kit data." }
      }
    },
    "champion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "alias",
        "name",
        "archetype",
        "positions",
        "damage",
        "threats",
        "healing",
        "shielding",
        "crowdControl",
        "scaling",
        "notes"
      ],
      "properties": {
        "id": { "type": "integer" },
        "alias": { "type": "string" },
        "name": { "type": "string" },
        "archetype": { "$ref": "#/$defs/archetype" },
        "positions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/position" },
          "description": "Where the champion is usually played, most common first."
        },
        "damage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["physical", "magic", "true"],
          "description": "Rough share of the damage the champion deals, in percent; the three add up to 100.",
          "properties": {
            "physical": { "type": "integer", "minimum": 0, "maximum": 100 },
            "magic": { "type": "integer", "minimum": 0, "maximum": 100 },
            "true": { "type": "integer", "minimum": 0, "maximum": 100 }
          }
        },
        "threats": {
          "type": "object",
          "description": "How much of each threat the champion brings (0-3). Omitted threats are 0.",
          "propertyNames": { "$ref": "#/$defs/threat" },
          "additionalProperties": { "$ref": "#/$defs/level" }
        },
        "healing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "sources"],
          "properties": {
            "level": { "$ref": "#/$defs/level" },
            "target": { "enum": ["self", "allies", "both"] },
            "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } }
          }
        },
        "shielding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "sources"],
          "properties": {
            "level": { "$ref": "#/$defs/level" },
            "target": { "enum": ["self", "allies", "both"] },
            "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } }
          }
        },
        "crowdControl": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "types"],
          "properties": {
            "level": { "$ref": "#/$defs/level" },
            "types": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": ["stun", "root", "knockup", "knockback", "pull", "charm", "fear", "taunt", "sleep", "suppression", "polymorph", "silence", "blind", "slow", "ground", "berserk", "stasis"]
              }
            }
          }
        },
        "scaling": {
          "type": "array",
          "uniqueItems": true,
          "description": "Stats the champion's damage or effects grow with, most important first.",
          "items": { "enum": ["AP", "AD", "bonusAD", "HP", "bonusHP", "armor", "MR", "attackSpeed", "crit", "lethality", "mana", "level"] }
        },
        "keyAbilities": {
          "type": "array",
          "description": "The abilities an opponent must play around, with why.",
          "items": { "$ref": "#/$defs/source" }
        },
        "notes": { "type": "string", "description": "pt-BR, 1-3 sentences: how this champion wins fights and what beats them." }
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threat", "weight"],
      "properties": {
        "threat": { "$ref": "#/$defs/threat" },
        "weight": { "type": "integer", "minimum": 1, "maximum": 3, "description": "How strongly it answers the threat." }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "goodFor", "answers", "notes"],
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": "string" },
        "goodFor": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/archetype" },
          "description": "Champion kinds that build it."
        },
        "answers": {
          "type": "array",
          "items": { "$ref": "#/$defs/answer" },
          "description": "Enemy threats the item counters, read from its tooltip (e.g. Grievous Wounds answers healing)."
        },
        "effects": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["antiheal", "shieldReduction", "armorPenetration", "magicPenetration", "percentHealthDamage", "spellShield", "stasis", "cleanse", "tenacity", "antiCrit", "antiAttackSpeed", "lifeline", "healingPower", "shieldPower", "slowResist", "magicResistance", "armor", "health", "omnivamp", "lifesteal"]
          }
        },
        "notes": { "type": "string", "description": "pt-BR, one sentence: when to buy it." }
      }
    },
    "rune": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "tree", "row", "goodFor", "answers", "notes"],
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": "string" },
        "tree": { "type": "integer", "description": "Perk style id (Precisão 8000, Dominação 8100, Feitiçaria 8200, Determinação 8400, Inspiração 8300)." },
        "row": { "type": "integer", "minimum": 0, "maximum": 3, "description": "0 keystone, 1-3 the minor rows." },
        "goodFor": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/archetype" } },
        "answers": { "type": "array", "items": { "$ref": "#/$defs/answer" } },
        "playstyle": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/threat" },
          "description": "Keystones: what the champion using it should be good at (burst for Eletrocutar, poke for Cometa Arcano…), matched against that champion's own threats."
        },
        "notes": { "type": "string", "description": "pt-BR, one sentence: why and when." }
      }
    }
  }
}
